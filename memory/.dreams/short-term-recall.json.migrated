    "memory:memory/.dreams/session-corpus/2026-05-05.txt:13:13": {
      "key": "memory:memory/.dreams/session-corpus/2026-05-05.txt:13:13",
      "path": "memory/.dreams/session-corpus/2026-05-05.txt",
      "startLine": 13,
      "endLine": 13,
      "source": "memory",
      "snippet": "Assistant: 作为竞品/参考架构有研究价值，但不构成直接威胁或机会 --- ### 五、底层逻辑 WeKnora 真正在做的事情，用第一性原理拆解： ``` 企业知识的本质矛盾： 知识存在 ≠ 知识可用 ≠ 知识自组织 传统方案（Confluence/Notion/飞书文档）： 人 → 手动整理 → 结构化 → 搜索 → 使用 问题：人不会整理、忘了整理、整理完就过时 WeKnora 的解法： 文档 → RAG检索（解决\"找到\"）→ Agent推理（解决\"理解\"）→ Wiki自组织（解决\"更新\"） 关键创新：Wiki模式让知识从\"静态快照\"变成\"",
      "recallCount": 0,
      "dailyCount": 1,
      "groundedCount": 0,
      "totalScore": 0.58,
      "maxScore": 0.58,
