# 敏感文件排除
.env
*.key
*.pem
**/.DS_Store

# OpenClaw 运行时文件（不含记忆）
BOOTSTRAP.md
*.log

# 可选：如果你有 MEMORY.md 包含敏感信息，取消下面这行
# MEMORY.md

# npm 缓存文件
%APPDATA%/npm-cache/
npm-cache/
node_modules/
.npm/
.cache/
.chroma_test/
__pycache__/
# KB 索引产物（可重建，不入版本库）
.kb_rag.db
.kb_rag.db-shm
.kb_rag.db-wal
.chroma_db/
memory/file_inventory.json
memory/file_scan_report.json


# 本地 scratch / 诊断脚本临时目录（可重建，不入库）
.tmp/
.tmp

# KB 可重建产物（每次周维护全量重写，不入版本库；与 file_inventory.json 同款先例）
skills/knowledge-base/routing-index.md
toolbox/kb_tools/KB_MOC.md
toolbox/kb_tools/scan_report.json


